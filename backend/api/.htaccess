# Нельзя отдавать конфиг напрямую. Каталоги src/ и seed/ закрыты своими .htaccess.
# (Запрет «на весь каталог» здесь нельзя: проверка доступа идёт до перезаписи /api/* в index.php.)
<FilesMatch "^config.*\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
